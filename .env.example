# Run:ai Application Environment Configuration
# Copy this file to .env and update the values for your environment

# Run:ai Control Plane Configuration
REACT_APP_RUNAI_CONTROL_PLANE=runai.example.com
REACT_APP_RUNAI_APP_NAME=your-app-name
REACT_APP_RUNAI_APP_SECRET=REDACTED

# Development Configuration
REACT_APP_USE_MOCK_DATA=false

# Optional: Enable debug logging in development
REACT_APP_DEBUG_LOGS=true
