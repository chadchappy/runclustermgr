# Copy to .env for local use (never commit real values).
RUNAI_CONTROL_PLANE=your-control-plane.example.com
RUNAI_CLIENT_ID=your-application-name
RUNAI_CLIENT_SECRET=your-application-secret
# Optional: protect the UI with HTTP basic auth
# UI_USER=admin
# UI_PASSWORD=change-me
# Optional policy
# EXCLUDE_CLUSTERS=cluster-name-or-uuid,another
# NO_FIT_STRATEGY=queue   # or reject
# ALLOW_UNKNOWN_CAPACITY=false
