# Copy to environments/<name>.env, edit, then:  scripts/deploy.sh environments/<name>.env
# No secrets here: credentials are referenced by file path.

# The kube context you intend to deploy to. The script refuses to run on any other.
EXPECT_CONTEXT=my-cluster

# Where the image lives (build with: docker buildx build --platform linux/amd64 -t $IMAGE .)
IMAGE=registry.example.com/runclustermgr:2.0.0

# Your Run:ai control plane (host only) and the application created in Run:ai
RUNAI_CONTROL_PLANE=runai.example.com
RUNAI_CLIENT_ID=my-app-name
RUNAI_CLIENT_SECRET_FILE=~/.secrets/clustermgr.secret

# --- optional ---
# HOST=clustermgr.runai.example.com            # default: clustermgr.$RUNAI_CONTROL_PLANE
# INGRESS=0                                    # no ingress; use kubectl port-forward
# INGRESS_CLASS=nginx                          # default: the cluster's default IngressClass
# TLS_SECRET_SOURCE=runai/runai-cluster-domain-tls-secret   # copy an existing TLS secret
# PULL_SECRET=my-regcred                       # existing image pull secret
# ECR_REGION=us-east-1                         # create/refresh an ECR pull secret
# NAMESPACE=clustermgr
# UI_USER=admin

# Placement policy
# NO_FIT_STRATEGY=queue                        # queue | reject
# EXCLUDE_CLUSTERS=scratch-cluster,uuid-of-another
# ALLOW_UNKNOWN_CAPACITY=false
# AUTO_CREATE_PROJECTS=false                   # true: create a matching project on a cluster that lacks it
